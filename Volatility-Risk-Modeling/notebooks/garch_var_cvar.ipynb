              "</style>\n",
              "<table border=\"1\" class=\"dataframe\">\n",
              "  <thead>\n",
              "    <tr style=\"text-align: right;\">\n",
              "      <th></th>\n",
              "      <th>Normal-GARCH</th>\n",
              "      <th>Student-t-GARCH</th>\n",
              "    </tr>\n",
              "  </thead>\n",
              "  <tbody>\n",
              "    <tr>\n",
              "      <th>Log-Likelihood</th>\n",
              "      <td>-1292.1792</td>\n",
              "      <td>-1169.5817</td>\n",
              "    </tr>\n",
              "    <tr>\n",
