              "      <td>2349.1635</td>\n",
              "    </tr>\n",
              "    <tr>\n",
              "      <th>BIC</th>\n",
              "      <td>2610.8173</td>\n",
              "      <td>2372.2371</td>\n",
              "    </tr>\n",
              "  </tbody>\n",
              "</table>\n",
              "</div>"
            ],
            "text/plain": [
              "                Normal-GARCH  Student-t-GARCH\n",
              "Log-Likelihood    -1292.1792       -1169.5817\n",
              "AIC                2592.3584        2349.1635\n",
              "BIC                2610.8173        2372.2371"
            ]
          },
          "execution_count": 6,
          "metadata": {},
          "output_type": "execute_result"
        }
      ],
      "source": [
        "normal_fit = arch_model(log_ret, mean=\"Constant\", vol=\"Garch\", p=1, q=1, dist=\"normal\").fit(disp=\"off\")\n",
        "t_fit = arch_model(log_ret, mean=\"Constant\", vol=\"Garch\", p=1, q=1, dist=\"t\").fit(disp=\"off\")\n",
        "\n",
        "comparison = pd.DataFrame({\n",
        "    \"Normal-GARCH\": {\"Log-Likelihood\": normal_fit.loglikelihood, \"AIC\": normal_fit.aic, \"BIC\": normal_fit.bic},\n",
        "    \"Student-t-GARCH\": {\"Log-Likelihood\": t_fit.loglikelihood, \"AIC\": t_fit.aic, \"BIC\": t_fit.bic},\n",
        "})\n",
        "comparison\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "0ef12b3a",
      "metadata": {
        "id": "0ef12b3a"
      },
      "source": [
        "Lower AIC/BIC and higher log-likelihood favor Student-t-GARCH if the table above shows it winning\n",
        "on all three -- which is the empirical justification (not just a theoretical assumption) for using\n",
        "Student-t errors from here on.\n"
      ]
    },
